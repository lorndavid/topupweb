# ═══════════════════════════════════════════════════════════════════
#  VidTopUp — Docker Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to Git.
# ═══════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────
MONGODB_DB_NAME=gametopup
# For local Docker Compose: leave MONGODB_URI empty — it uses internal Docker DNS
# For production standalone: MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/gametopup

# ─── Bay2Game API ─────────────────────────────────────────────────
BAY2GAME_API_URL=https://api.bay2game.xyz
BAY2GAME_API_KEY=your_bay2game_api_key_here

# ─── CutLuy Payment (ABA/Bakong KHQR) ────────────────────────────
CUTLUY_API_KEY=ck_live_your_cutluy_api_key_here
CUTLUY_API_URL=https://cutluy.com/v1
CUTLUY_WEBHOOK_SECRET=your_cutluy_webhook_secret
# Where CutLuy redirects after payment — must match your frontend domain
CUTLUY_RETURN_URL=https://topup.lorndavid.online/payment/success

# ─── Frontend URLs (used for CORS and webhook return URLs) ────────
FRONTEND_URL=https://topup.lorndavid.online
ADMIN_FRONTEND_URL=https://admintopup.lorndavid.online

# ─── Push Notifications (Web Push) ────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@vidtopup.com

# ─── Telegram Notifications ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
NOTIFICATION_WEBHOOK_URL=

# ─── Admin Dashboard Auth ─────────────────────────────────────────
# Generate a strong JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=your_secure_jwt_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Merchant Info ────────────────────────────────────────────────
MERCHANT_NAME=MY SHOP
MERCHANT_CITY=Phnom Penh
DEFAULT_CURRENCY=USD

# ─── Game APIs (optional) ─────────────────────────────────────────
RIOT_API_KEY=
GAMESKINBO_API_KEY=
