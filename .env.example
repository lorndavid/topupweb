# ═══════════════════════════════════════════════════════════════════
#  VidTopUp — Docker Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to Git.
# ═══════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────
MONGODB_DB_NAME=gametopup
# For Debian Docker Compose (local MongoDB container):
MONGODB_URI=mongodb://mongo:27017/gametopup
# For external MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/gametopup?retryWrites=true&w=majority

# ─── Bay2Game API ─────────────────────────────────────────────────
BAY2GAME_API_URL=https://api.bay2game.xyz
BAY2GAME_API_KEY=your_bay2game_api_key_here

# ─── CutLuy Payment (ABA/Bakong KHQR) ────────────────────────────
CUTLUY_API_KEY=ck_live_your_cutluy_api_key_here
CUTLUY_API_URL=https://cutluy.com/v1
CUTLUY_WEBHOOK_SECRET=your_cutluy_webhook_secret
# Where CutLuy redirects after payment — must match your frontend domain
CUTLUY_RETURN_URL=https://vidtopup.store/payment/success

# ─── Frontend URLs (used for CORS and webhook return URLs) ────────
FRONTEND_URL=https://vidtopup.store
ADMIN_FRONTEND_URL=https://admin.vidtopup.store

# ─── Backend Docker image (for docker-compose.backend.yml) ────────
# CI pushes to Docker Hub: <DOCKER_USERNAME>/vidtopup-backend:latest
BACKEND_IMAGE=vidtopup-backend:latest

# ─── Cloudflare Tunnel (backend VPS only) ─────────────────────────
# Create a tunnel in the Cloudflare Zero Trust dashboard, map
# api.vidtopup.store → http://backend:3001, and paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Push Notifications (Web Push) ────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@vidtopup.store

# ─── Telegram Notifications ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
NOTIFICATION_WEBHOOK_URL=

# ─── Admin Dashboard Auth ─────────────────────────────────────────
# Generate a strong JWT secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET=your_secure_jwt_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Merchant Info ────────────────────────────────────────────────
MERCHANT_NAME=MY SHOP
MERCHANT_CITY=Phnom Penh
DEFAULT_CURRENCY=USD

# ─── Game APIs (optional) ─────────────────────────────────────────
RIOT_API_KEY=
GAMESKINBO_API_KEY=
