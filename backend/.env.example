# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Bay2Game Reseller API
BAY2GAME_API_URL=https://api.bay2game.xyz
BAY2GAME_API_KEY=your_bay2game_api_key_here

# ─── Bakong Merchant Info ─────────────────────────────
MERCHANT_BAKONG_ID=lorn_davit@bkrt     # Your Bakong account ID (phone/email@bkrt)
MERCHANT_NAME=MY SHOP                  # Your shop name shown on QR
MERCHANT_CITY=Phnom Penh               # Your city shown on QR
DEFAULT_CURRENCY=USD                   # Default currency for pricing

# ─── Bakong API (Official NBC) ─────────────────────────
# Get your token from: https://developer.bakong.nbc.gov.kh
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=your_bakong_api_token_here
BAKONG_CALLBACK_URL=http://localhost:3001/api/payment/callback
BAKONG_RETURN_URL=http://localhost:5173/payment/success

# ─── MongoDB ───────────────────────────────────────────
# Get your free cluster from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=gametopup
