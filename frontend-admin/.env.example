# Admin Dashboard Environment Variables
# For development: Vite proxy handles /api → localhost:3001 automatically
# For production: Set the real API URL

# Backend API base URL
VITE_API_BASE_URL=/api

# For production deployment, set:
# VITE_API_BASE_URL=https://api.topup.lorndavid.online

ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_custom_secure_password_here
ADMIN_JWT_SECRET=a_long_random_string_for_token_signing