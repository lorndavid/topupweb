# ═══════════════════════════════════════════════════════════════════
#  VidTopUp — Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════
#  In production on Vercel, set these in Project Settings -> Environment Variables.

# Backend API Base URL (leave empty in local dev if using Vite proxy)
VITE_API_BASE_URL=https://api.vidtopup.store

# Google Analytics 4 (GA4) Measurement ID (e.g. G-ABC123XYZ)
# Obtain from: https://analytics.google.com -> Admin -> Data Streams -> Web
VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML verification code
# Obtain from: https://search.google.com/search-console -> Add Property -> HTML tag
VITE_GOOGLE_SITE_VERIFICATION=

# Web Push Notifications public VAPID key (optional)
VITE_VAPID_PUBLIC_KEY=
