# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────
# Bay2Game Reseller API
# ──────────────────────────────────────────────────────────
# Get your API key from @Bay2GameBot on Telegram
BAY2GAME_API_URL=https://api.bay2game.xyz
BAY2GAME_API_KEY=your_bay2game_api_key_here

# ──────────────────────────────────────────────────────────
# Bakong Merchant Info (REQUIRED for valid KHQR)
# ──────────────────────────────────────────────────────────
# Your Bakong account ID - this is what appears on the QR code.
# Format: your_phone_or_email@bkrt (e.g. "lorn_davit@bkrt")
# If you don't have one, register in the Bakong app.
MERCHANT_BAKONG_ID=lorn_davit@bkrt

# Your shop/merchant name (displayed on the QR)
MERCHANT_NAME=MY SHOP
# Your city (displayed on the QR)
MERCHANT_CITY=Phnom Penh
# Default currency for pricing display
DEFAULT_CURRENCY=USD

# ──────────────────────────────────────────────────────────
# Bakong API (Official NBC) — OPTIONAL but RECOMMENDED
# ──────────────────────────────────────────────────────────
# The Bakong API provides REAL-time payment checking and QR generation.
# Without it, the app still works in dev mode using the bakong-khqr SDK.
#
# How KHQR generation works (in order of preference):
#   1. Bakong API (/v1/generate_qr) — REAL QR from NBC servers
#   2. bakong-khqr SDK — Official NBC JavaScript library (EMVCo-compliant)
#   3. Dev fallback — Simple text QR (dev mode only)
#
# Get your API token from: https://developer.bakong.nbc.gov.kh
# (You need to register as a merchant/developer on the NBC portal)
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=

# Callback URL: Bakong will POST payment confirmation here (optional)
BAKONG_CALLBACK_URL=http://localhost:3001/api/payment/callback
# Return URL: where users go after successful payment
BAKONG_RETURN_URL=http://localhost:5173/payment/success

# ──────────────────────────────────────────────────────────
# MongoDB (REQUIRED)
# ──────────────────────────────────────────────────────────
# Get your free cluster from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=gametopup

# ──────────────────────────────────────────────────────────
# Notifications (OPTIONAL but RECOMMENDED)
# ──────────────────────────────────────────────────────────
# When a customer pays but your Bay2Game balance is too low to deliver,
# the system sends alerts so you can add funds immediately.
#
# Both Telegram and Webhook are supported — you can use one or both.
#
# ── TELEGRAM ────────────────────────────────────────────
# 1. Create a bot via @BotFather on Telegram → get a token like:
#    1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
# 2. Find your Chat ID by messaging your bot and visiting:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 3. Add the token and Chat ID below:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# ── WEBHOOK ─────────────────────────────────────────────
# For Discord: use Discord webhook URL
# For Slack: use Slack Incoming Webhook URL
# For your own server: any POST endpoint that accepts JSON
NOTIFICATION_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────
# Game Player Lookup APIs (OPTIONAL)
# ──────────────────────────────────────────────────────────
# NO LONGER NEEDED: Player verification now uses Bay2Game's
# public Check ID API (no API key required):
#   GET https://checkid.bay2game.xyz/check_id?game=mlbb&userid=123456
#
# The following are kept for backward compatibility:
RIOT_API_KEY=
GAMESKINBO_API_KEY=
